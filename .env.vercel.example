# Server-only. Copy values into Vercel Settings > Environment Variables.
# Use separate projects/buckets for Preview and Production.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sikepel
# Option A: ConvertAPI (temporary cloud converter)
PDF_CONVERTER_PROVIDER=convertapi
PDF_CONVERTER_URL=https://v2.convertapi.com
PDF_CONVERTER_TOKEN=
# Option B: self-hosted Gotenberg
# PDF_CONVERTER_PROVIDER=gotenberg
# PDF_CONVERTER_URL=https://YOUR-CONVERTER-HOST
# PDF_CONVERTER_USERNAME=sikepel
# PDF_CONVERTER_PASSWORD=

# Only for one-time cloud:init on a trusted computer, NOT Vercel runtime:
# SIKEPEL_ADMIN_NAME=
# SIKEPEL_ADMIN_USERNAME=
# SIKEPEL_ADMIN_PASSWORD=
# SIKEPEL_DISTRICT=
# SIKEPEL_CITY=
