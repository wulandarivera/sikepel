# Local installation needs no environment variables. Defaults:
# SIKEPEL_DATA_DIR=.data
# LIBREOFFICE_PATH=D:/IMRON/Project Sikepel/.tools/LibreOffice/program/soffice.exe

# Optional PostgreSQL adapter (not needed for PGlite local mode):
# DATABASE_URL=postgresql://user:password@host:5432/sikepel

# Optional private Supabase storage adapter (server only):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=sikepel

# Optional authenticated Gotenberg converter (server only):
# PDF_CONVERTER_URL=https://your-converter.example
# PDF_CONVERTER_TOKEN=
# PDF_CONVERTER_PROVIDER=convertapi
# PDF_CONVERTER_USERNAME=
# PDF_CONVERTER_PASSWORD=
# For Vercel deployment, see .env.vercel.example and DEPLOY-VERCEL.md.

# Local is bound to loopback by the npm scripts. Do not expose the sample
# environment to the internet. Cloud migration requires separate configuration.
