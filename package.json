{
  "name": "sikepel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "vercel-build": "npm run cloud:check && next build",
    "cloud:check": "tsx scripts/check-cloud.ts",
    "cloud:init": "tsx scripts/init-cloud.ts",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup": "tsx scripts/setup.ts",
    "postinstall": "node scripts/prepare-assets.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "wa:build": "cd services/whatsapp-gateway && npm run build",
    "wa:start": "cd services/whatsapp-gateway && npm run start",
    "wa:qr": "cd services/whatsapp-gateway && npm run qr",
    "wa:test": "cd services/whatsapp-gateway && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.5.0",
    "docxtemplater": "^3.67.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.0",
    "pizzip": "^3.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@next/env": "^16.3.4",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
