      "2. Pendidikan",
      "3. Keamanan",
      "4. Kesehatan",
      "5. Perumahan",
      "6. Keluarga",
      "7. Lainnya"
    ]
  },
  {
    "key": "no_jenis_pindah",
    "label": "Jenis kepindahan",
    "type": "select",
    "required": true,
    "options": [
