      "2. Membuat KK Baru",
      "3. Nomor KK Tetap",
      "4. Tidak Ada Keluarga yang Ditinggal"
    ]
  },
  {
    "key": "no_keluarga_pindah",
    "label": "Status KK anggota yang pindah",
    "type": "select",
    "required": true,
    "options": [
      "1. Numpang KK",
      "2. Membuat KK Baru",
      "3. Nomor KK Tetap"
    ]
