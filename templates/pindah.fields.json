  {
    "key": "nomor_handphone",
    "label": "Nomor HP pemohon (opsional)",
    "type": "text",
    "required": false
  },
  {
    "key": "email",
    "label": "Email pemohon (opsional)",
    "type": "text",
    "required": false
  },
  {
    "key": "catatan",
