    "options": [
      "1. Dalam satu desa/kelurahan",
      "2. Antar desa/kelurahan dalam satu kecamatan",
      "3. Antar kecamatan dalam satu kabupaten/kota",
      "4. Antar kabupaten/kota dalam satu provinsi",
      "5. Antar provinsi"
